{
  "color": {
    "bg": "#08090B",
    "text": "#F2F4F7",
    "text-muted": "#A0A6AF",
    "link": "#7CC4FF",
    "action": "#0071E3",
    "action-hover": "#0066CC",
    "action-text": "#FFFFFF",
    "surface-glass": "rgba(24, 26, 30, 0.55)",
    "hairline": "rgba(255, 255, 255, 0.10)",
    "nav": "rgba(8, 9, 11, 0.64)",
    "wash-hover": "rgba(255, 255, 255, 0.08)",
    "segment-active-bg": "#F2F4F7",
    "segment-active-text": "#08090B",
    "tint": "color-mix(in oklab, var(--a) 62%, #F2F4F7)",
    "tint-b": "color-mix(in oklab, var(--b) 62%, #F2F4F7)",
    "text-gradient": "linear-gradient(100deg, #F2F4F7 0%, color-mix(in oklab, var(--a) 62%, #F2F4F7) 52%, color-mix(in oklab, var(--b) 62%, #F2F4F7) 100%)"
  },
  "glow": {
    "registeredProperties": {
      "--a": {
        "syntax": "<color>",
        "initial": "#DCE6F5"
      },
      "--b": {
        "syntax": "<color>",
        "initial": "#5AA9FF"
      },
      "--gx": {
        "syntax": "<percentage>",
        "initial": "18%"
      }
    },
    "keyframes": [
      {
        "at": "0%",
        "a": "#DCE6F5",
        "b": "#5AA9FF",
        "gx": "18%"
      },
      {
        "at": "33%",
        "a": "#5AA9FF",
        "b": "#E4EAF2",
        "gx": "72%"
      },
      {
        "at": "66%",
        "a": "#9FB8D9",
        "b": "#64D2FF",
        "gx": "30%"
      },
      {
        "at": "100%",
        "a": "#E4EAF2",
        "b": "#5AA9FF",
        "gx": "80%"
      }
    ],
    "timeline": "scroll(nearest) on .page; linear; fill both",
    "layers": [
      "radial-gradient(34% 72% at var(--gx) -12%, color-mix(in srgb, var(--a) 40%, transparent), transparent 70%)",
      "radial-gradient(26% 58% at calc(100% - var(--gx)) -8%, color-mix(in srgb, var(--b) 40%, transparent), transparent 72%)",
      "radial-gradient(70% 30% at 50% 110%, color-mix(in srgb, var(--a) 14%, transparent), transparent 70%)",
      "#08090B"
    ]
  },
  "font": {
    "family": "-apple-system, BlinkMacSystemFont, 'SF Pro Text', 'Inter', 'Segoe UI', sans-serif",
    "webfont": "https://fonts.googleapis.com/css2?family=Inter:opsz,wght@14..32,400;14..32,500;14..32,600;14..32,700&display=swap",
    "smoothing": "antialiased"
  },
  "type": {
    "display-hero": {
      "size": "clamp(56px, 9vw, 112px)",
      "weight": 700,
      "lineHeight": 1.02,
      "tracking": "-0.045em"
    },
    "display-metric": {
      "size": "clamp(64px, 9vw, 120px)",
      "weight": 700,
      "lineHeight": 0.95,
      "tracking": "-0.05em"
    },
    "headline": {
      "size": "clamp(40px, 5.4vw, 64px)",
      "weight": 700,
      "lineHeight": 1.05,
      "tracking": "-0.04em"
    },
    "statement-contact": {
      "size": "clamp(34px, 5vw, 60px)",
      "weight": 700,
      "lineHeight": 1.08,
      "tracking": "-0.04em"
    },
    "statement": {
      "size": "clamp(30px, 4vw, 48px)",
      "weight": 600,
      "lineHeight": 1.12,
      "tracking": "-0.03em"
    },
    "title-company": {
      "size": "clamp(36px, 4.6vw, 56px)",
      "weight": 700,
      "lineHeight": 1.05,
      "tracking": "-0.04em"
    },
    "metric": {
      "size": "64px",
      "weight": 700,
      "lineHeight": 1,
      "tracking": "-0.045em"
    },
    "project-word": {
      "size": "54px",
      "weight": 700,
      "lineHeight": 1.05,
      "tracking": "-0.045em"
    },
    "stat": {
      "size": "44px",
      "weight": 700,
      "tracking": "-0.04em"
    },
    "title-l": {
      "size": "32px",
      "weight": 700,
      "tracking": "-0.03em"
    },
    "title-m": {
      "size": "26px",
      "weight": 600,
      "lineHeight": 1.25,
      "tracking": "-0.025em"
    },
    "lead": {
      "size": "clamp(20px, 2vw, 26px)",
      "weight": 500,
      "lineHeight": 1.38,
      "tracking": "-0.012em"
    },
    "title-s": {
      "size": "23px",
      "weight": 600,
      "lineHeight": 1.22,
      "tracking": "-0.02em"
    },
    "body-l": {
      "size": "21px",
      "weight": "500 (subheads) / 600 (hero eyebrow, -0.01em)",
      "lineHeight": "1.35–1.4"
    },
    "title-xs": {
      "size": "19px",
      "weight": 600
    },
    "body": {
      "size": "17px",
      "weight": "400 / 500 buttons",
      "lineHeight": "1.45–1.55"
    },
    "callout": {
      "size": "15px",
      "weight": 600
    },
    "caption": {
      "size": "14px",
      "weight": "400 / 600"
    },
    "nav": {
      "size": "13px",
      "weight": 400,
      "name": {
        "size": "15px",
        "weight": 600,
        "tracking": "-0.01em"
      }
    },
    "micro": {
      "size": "12px",
      "weight": 400
    }
  },
  "space": {
    "2": "segment gap",
    "4": "segmented padding",
    "6": "gradient-text bottom padding",
    "8": "CTA row top / carousel top",
    "10": "label to figure",
    "12": "tile inner gap",
    "14": "section header gap / stack tile gap",
    "16": "carousel bottom",
    "18": "highlight top padding",
    "20": "grid gap",
    "22": "CTA gap",
    "24": "gutter",
    "26": "hero gap",
    "28": "highlight row gap",
    "30": "card padding",
    "32": "header to content / stack tile padding",
    "36": "project text padding",
    "40": "tile padding / highlight column gap",
    "48": "lead tile padding",
    "56": "panel padding max",
    "96": "hero bottom",
    "112": "hero top",
    "120": "statement and contact bottom",
    "140": "section bottom"
  },
  "radius": {
    "pill": "980px",
    "panel": "30px",
    "card": "28px",
    "cell": "4px",
    "avatar": "50%",
    "aside": "980px"
  },
  "effect": {
    "glass": "blur(28px) saturate(1.5)",
    "nav": "blur(20px) saturate(1.8)",
    "avatarGlow": "0 0 0 1px rgba(255,255,255,0.10), 0 40px 100px -24px color-mix(in srgb, var(--a) 70%, transparent)",
    "focusRing": "2px solid #7CC4FF, offset 3px"
  },
  "layout": {
    "container": "1040px",
    "containerNarrow": "920px",
    "gutter": "24px",
    "navHeight": "52px",
    "breakpoint": "760px",
    "carouselCard": "320 x 300",
    "carouselInset": "max(24px, calc((100% - 992px) / 2))"
  },
  "motion": {
    "heroExit": {
      "timeline": "view()",
      "range": "exit 0% exit 85%",
      "to": {
        "opacity": 0.12,
        "transform": "scale(.93) translateY(-24px)",
        "filter": "blur(6px)"
      },
      "reducedMotion": "off"
    },
    "cardHover": {
      "transform": "translateY(-4px)",
      "duration": "350ms",
      "easing": "cubic-bezier(.2, .8, .2, 1)",
      "reducedMotion": "off"
    },
    "aside": {
      "duration": "160ms",
      "easing": "cubic-bezier(.2, .8, .2, 1)",
      "offset": "10px",
      "maxWidth": "280px",
      "fill": "action blue #0071E3 with white text",
      "shape": "pill, cursor tip near top-left",
      "cursor": "Figma-style multiplayer arrow, action blue fill, white stroke; hides native cursor while active",
      "reducedMotion": "off",
      "pointer": "fine hover only"
    }
  },
  "z": {
    "glow": 0,
    "content": 1,
    "nav": 10,
    "aside": 20
  }
}